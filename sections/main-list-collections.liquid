<section class="page-section"><div class="container"><h1>{{ section.settings.title }}</h1><div class="category-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="category-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}<h2>{{ collection.title }}</h2><span>Shop now →</span></a>{% endunless %}{% endfor %}</div></div></section>{% schema %}{"name":"Collections list","settings":[{"type":"text","id":"title","label":"Title","default":"Shop Categories"}],"presets":[{"name":"Collections list"}]}{% endschema %}