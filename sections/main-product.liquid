<section class="section"><div class="container"><div class="grid" style="grid-template-columns:1fr 1fr"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title }}{% endif %}</div><div><h1>{{ product.title }}</h1><div class="price">{{ product.price | money }}</div>{% form 'product', product %}{% unless product.has_only_default_variant %}<label for="variant">Choose option</label><select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="quantity">Quantity</label><input id="quantity" type="number" name="quantity" value="1" min="1"><button class="button button--gold" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</button>{% endform %}<div>{{ product.description }}</div></div></div></div></section>{% schema %}{"name":"Main Product","settings":[]}{% endschema %}