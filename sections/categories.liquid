<section class="section"><div class="container"><h2>{{ section.settings.heading }}</h2><div class="grid">{% assign cats='Fresh Produce|Meat & Seafood|Dairy & Eggs|Bakery|Pantry|Snacks|Drinks|Frozen|Household Essentials' | split: '|' %}{% for cat in cats %}<a class="category" href="{{ routes.collections_url }}">{{ cat }}</a>{% endfor %}</div></div></section>{% schema %}{"name":"Shop by Category","settings":[{"type":"text","id":"heading","label":"Heading","default":"SHOP BY CATEGORY"}],"presets":[{"name":"Shop by Category"}]}{% endschema %}