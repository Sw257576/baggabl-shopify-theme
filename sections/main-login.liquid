<section class="page-section"><div class="container account-form"><h1>Sign in</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required><button class="button button--gold" type="submit">Sign in</button>{% endform %}<a href="{{ routes.account_register_url }}">Create account</a></div></section>{% schema %}{"name":"Customer login","settings":[],"presets":[{"name":"Customer login"}]}{% endschema %}