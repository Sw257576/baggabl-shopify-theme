<section class="page-section"><div class="container"><h1>{{ 'general.search.search' | t | default: 'Search' }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search groceries" aria-label="Search groceries"><button class="button button--gold" type="submit">Search</button></form>{% if search.performed %}<p class="results-count">{{ search.results_count }} results</p>{% if search.results.size > 0 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="search-result"><a href="{{ item.url }}"><h2>{{ item.title }}</h2></a>{% if item.content %}<p>{{ item.content | strip_html | truncate: 140 }}</p>{% endif %}</article>{% endif %}{% endfor %}</div>{% else %}<p>No groceries found. Try another search.</p>{% endif %}{% endif %}</div></section>{% schema %}{"name":"Search results","settings":[],"presets":[{"name":"Search results"}]}{% endschema %}