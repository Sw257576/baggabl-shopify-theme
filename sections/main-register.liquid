<section class="page-section"><div class="container account-form"><h1>Create your Baggabl account</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label for="FirstName">First name</label><input id="FirstName" type="text" name="customer[first_name]" autocomplete="given-name" required><label for="LastName">Last name</label><input id="LastName" type="text" name="customer[last_name]" autocomplete="family-name" required><label for="RegisterEmail">Email</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required><label for="RegisterPassword">Password</label><input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required><button class="button button--gold" type="submit">Create account</button>{% endform %}<a href="{{ routes.account_login_url }}">Already have an account? Sign in</a></div></section>{% schema %}{"name":"Customer registration","settings":[],"presets":[{"name":"Customer registration"}]}{% endschema %}