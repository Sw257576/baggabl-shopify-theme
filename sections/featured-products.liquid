<section class="section"><div class="container"><h2>{{ section.settings.heading }}</h2>{% assign collection = collections[section.settings.collection] %}{% if collection != blank %}<div class="grid">{% for product in collection.products limit: 8 %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</div></section>{% schema %}{"name":"Featured Products","settings":[{"type":"text","id":"heading","label":"Heading","default":"WHAT’S IN YOUR BAGGABL?"},{"type":"collection","id":"collection","label":"Collection"}],"presets":[{"name":"Featured Products"}]}{% endschema %}