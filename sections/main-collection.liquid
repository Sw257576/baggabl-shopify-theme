<section class="section"><div class="container"><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}<div class="grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found.</p>{% endfor %}</div></div></section>{% schema %}{"name":"Main Collection","settings":[]}{% endschema %}