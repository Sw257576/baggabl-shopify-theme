<section class="hero" style="background-image:linear-gradient(90deg,rgba(17,17,17,.96) 0%,rgba(17,17,17,.78) 52%,rgba(17,17,17,.45) 100%),url('{{ 'Screenshot 2026-09-11 8.23.36 PM.png' | asset_url }}');"><div class="container"><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><div class="hero-free-delivery">100% FREE DELIVERY — NO DELIVERY CHARGE</div><a class="button button--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div></section>{% schema %}{"name":"Hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"GROCERIES. DELIVERED. SIMPLE."},{"type":"textarea","id":"text","label":"Text","default":"Your everyday groceries, delivered straight to your door without the unnecessary hassle."},{"type":"text","id":"button_label","label":"Button label","default":"SHOP GROCERIES"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Baggabl Hero"}]}{% endschema %}