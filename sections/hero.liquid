<section class="hero"><div class="container"><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><a class="button button--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div></section>{% schema %}{"name":"Hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"GROCERIES. DELIVERED. SIMPLE."},{"type":"textarea","id":"text","label":"Text","default":"Your everyday groceries, delivered straight to your door without the unnecessary hassle."},{"type":"text","id":"button_label","label":"Button label","default":"SHOP GROCERIES"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Baggabl Hero"}]}{% endschema %}