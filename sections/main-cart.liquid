<section class="section"><div class="container"><h1>Your Cart</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><table class="cart-table"><thead><tr><th>Product</th><th>Qty</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr><td><a href="{{ item.url }}">{{ item.product.title }}</a></td><td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><h2>Total: {{ cart.total_price | money }}</h2><button class="button" type="submit" name="update">Update Cart</button><button class="button button--gold" type="submit" name="checkout">Checkout</button></form>{% else %}<p>Your cart is empty.</p><a class="button button--gold" href="{{ routes.all_products_collection_url }}">Shop Groceries</a>{% endif %}</div></section>{% schema %}{"name":"Main Cart","settings":[]}{% endschema %}