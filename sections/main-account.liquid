<section class="page-section"><div class="container"><div class="account-header"><h1>Welcome back, {{ customer.first_name | escape }}</h1><a href="{{ routes.account_logout_url }}">Sign out</a></div><h2>Order history</h2>{% if customer.orders.size > 0 %}<div class="order-list">{% for order in customer.orders %}<div class="order-card"><strong>{{ order.name }}</strong><span>{{ order.created_at | date: '%B %d, %Y' }}</span><span>{{ order.total_price | money }}</span><a href="{{ order.customer_url }}">View order</a></div>{% endfor %}</div>{% else %}<p>You haven't placed an order yet.</p><a class="button button--gold" href="{{ routes.all_products_collection_url }}">Shop groceries</a>{% endif %}</div></section>{% schema %}{"name":"Customer account","settings":[],"presets":[{"name":"Customer account"}]}{% endschema %}